# JARVIS Finance — example configuration.
# Copy to .env and fill in only what you need. Never commit .env.

JARVIS_ENV=dev
JARVIS_LOG_LEVEL=INFO

# Local SQLite ledger
JARVIS_DB_PATH=data/jarvis.db
JARVIS_CACHE_DIR=data/cache

# AI is OFF by default. Set a key only if you want the optional assistant.
JARVIS_LLM_MODE=offline
JARVIS_LLM_API_KEY=
JARVIS_LLM_BASE_URL=https://api.example.com/v1
JARVIS_LLM_MODEL=example-model
JARVIS_DAILY_BUDGET_USD=0.10
JARVIS_MONTHLY_BUDGET_USD=3.00

# Optional public front door (Cloudflare Tunnel + Access).
# Leave empty to keep the app loopback-only.
JARVIS_PUBLIC_ORIGIN=

# Optional read-only MCP endpoints/commands for market and bank data.
# Leave empty unless you run your own trusted MCP servers.
JARVIS_MOEX_MCP_URL=
JARVIS_SBER_MCP_URL=
JARVIS_TBANK_MCP_URL=
JARVIS_MOEX_MCP_COMMAND=
JARVIS_SBER_MCP_COMMAND=
JARVIS_TBANK_MCP_COMMAND=
